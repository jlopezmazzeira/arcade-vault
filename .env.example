# Copia este archivo a .env.local y rellena los valores.

# --- Resend (contacto) ---
# Variables de servidor: ninguna lleva prefijo NEXT_PUBLIC_.

# Clave de la API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Remitente del correo de contacto.
# Con onboarding@resend.dev no hace falta verificar dominio, pero OJO:
# ese remitente SOLO entrega al correo de la cuenta de Resend. Con cualquier
# otro CONTACT_TO_EMAIL la API responde 200 y el correo nunca llega.
CONTACT_FROM_EMAIL=

# Destinatario: el equipo. Mientras el remitente sea onboarding@resend.dev,
# tiene que ser el correo con el que se creó la cuenta de Resend.
CONTACT_TO_EMAIL=

# --- Supabase (autenticación) ---
# A DIFERENCIA de las de arriba, estas SÍ son públicas por diseño: llevan el
# prefijo NEXT_PUBLIC_ y viajan al navegador. La protección real es RLS en el
# servidor (territorio de una spec posterior); hasta entonces no hay tablas que
# exponer. Los valores reales van en .env.local (crea el proyecto en el
# dashboard de Supabase y desactiva Auth → Providers → Email → "Confirm email").

# URL del proyecto Supabase (https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima / publishable del proyecto
NEXT_PUBLIC_SUPABASE_ANON_KEY=
